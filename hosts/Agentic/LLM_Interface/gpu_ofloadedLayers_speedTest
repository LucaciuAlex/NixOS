import time
import subprocess
import requests
import json
from pathlib import Path

# Configuration
SERVER_URL = "http://127.0.0.1:1234"
CONF_PATH = Path("/var/lib/llama/server.conf")
MAX_LAYERS = 32  # Qwen 3.5 9B has 32 layers total

# A decently sized test prompt to stress token generation and evaluation
TEST_PROMPT = (
    "Explain the step-by-step process of how transformers handle attention mechanisms, "
    "quantization trade-offs in GGUF formats, and how KV cache memory scales with context length. "
    "Provide a detailed technical breakdown."
)

MODEL = "Qwen3.5-9B-Q4_K_M.gguf"

def update_server_config(gpu_layers: int):
    """Updates the server configuration file consumed by your systemd runner."""
    print(f"\n[Config] Setting GPU_LAYERS={gpu_layers}...")
    # Using sudo via python assuming user has privileges or running under proper permissions
    subprocess.run(f"echo 'GPU_LAYERS={gpu_layers}' | sudo tee {CONF_PATH} > /dev/null", shell=True, check=True)

def restart_server(layers: int):
    """Triggers the custom server script and dynamically polls /health until ready."""
    print(f"\n[Service] Switching model configuration to {layers} GPU layers...")
    
    # Trigger the shell helper script
    subprocess.run(f"llamacpp-serve {MODEL} {layers}", shell=True, check=True)
    
    print("[Service] Dynamically waiting for model to load into VRAM...")
    start_time = time.time()
    
    while time.time() - start_time < 60:  # Timeout after 60 seconds
        try:
            # llama-server returns HTTP 503 while loading, and HTTP 200 {"status": "ok"} when ready
            res = requests.get(f"{SERVER_URL}/health", timeout=1)
            
            if res.status_code == 200:
                data = res.json()
                if data.get("status") == "ok":
                    print("[Service] Server is fully loaded and ready.")
                    time.sleep(0.5)  # Micro-stabilization pause
                    return True
            elif res.status_code == 503:
                # Model is still loading weights into VRAM; keep waiting
                pass
        except requests.exceptions.RequestException:
            # Connection refused can happen briefly while the HTTP socket binds
            pass
            
        # Verify the background systemd service didn't crash during boot
        status_check = subprocess.run("systemctl is-active llama-custom-server", shell=True, capture_output=True, text=True)
        if "inactive" in status_check.stdout or "failed" in status_check.stdout:
            print("\n❌ [Service] llama-custom-server crashed during startup!")
            subprocess.run("journalctl -u llama-custom-server -n 10 --no-pager", shell=True)
            raise RuntimeError("Server process died unexpectedly during startup.")

        time.sleep(1)

    raise RuntimeError("Server failed to become healthy within the timeout period.")


def get_current_vram_usage() -> str:
    """Queries nvidia-smi for current VRAM usage on GPU 0."""
    try:
        cmd = "nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits"
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True, check=True)
        vram_mb = result.stdout.strip()
        return f"{vram_mb} MB"
    except Exception:
        return "N/A"

def run_benchmark(gpu_layers: int) -> dict:
    """Sends a chat completion request and extracts speed timings from llama-server."""
    payload = {
        "model": "current-model.gguf",
        "messages": [{"role": "user", "content": TEST_PROMPT}],
        "temperature": 0.1,
        "max_tokens": 150  # Fixed output length for fair speed comparison
    }

    start_time = time.time()
    try:
        response = requests.post(f"{SERVER_URL}/v1/chat/completions", json=payload, timeout=60)
        response.raise_for_status()
        data = response.json()
    except Exception as e:
        return {"error": str(e)}

    
    total_time = time.time() - start_time

    vram_used = get_current_vram_usage()

    # llama-server includes timing metrics inside the response object
    timings = data.get("usage", {})
    prompt_tokens = timings.get("prompt_tokens", 0)
    completion_tokens = timings.get("completion_tokens", 0)
    
    # Extract native llama.cpp timing stats if exposed in response metadata
    # (llama-server appends 'timings' block in OpenAI compatibility mode depending on version)
    server_timings = data.get("timings", {})
    eval_ms = server_timings.get("predicted_ms", 0)
    eval_tokens = server_timings.get("predicted_n", completion_tokens)
    
    # Calculate tokens per second fallback if server_timings isn't unpacked
    t_per_sec = (eval_tokens / (eval_ms / 1000.0)) if eval_ms > 0 else (completion_tokens / total_time)

    return {
        "gpu_layers": gpu_layers,
        "prompt_tokens": prompt_tokens,
        "completion_tokens": completion_tokens,
        "total_time_sec": round(total_time, 2),
        "tokens_per_sec": round(t_per_sec, 2),
        "used_vram": vram_used
    }

if __name__ == "__main__":
    # Define layer configurations to test (e.g., full offload down to partial offload)
    # Adjust step sizes based on how granular you want the test to be
    layers_to_test = [32, 31, 30, 29, 28, 27, 26, 25, 24]

    results = []

    print("=" * 70)
    print(" 🚀 LLAMA.CPP LAYER OFFLOAD BENCHMARKING SUITE")
    print("=" * 70)

    for layers in layers_to_test:
        try:
            update_server_config(layers)
            restart_server(layers)
            
            print(f"[Benchmark] Running test with {layers} GPU layers...")
            metrics = run_benchmark(layers)
            results.append(metrics)
            print(f"[Results] Layers: {layers} | Speed: {metrics.get('tokens_per_sec', 'N/A')} tok/s")
        except Exception as e:
            print(f"❌ Error testing {layers} layers: {e}")
            results.append({"gpu_layers": layers, "error": str(e)})

    print("\n" + "=" * 70)
    print(" 📊 FINAL BENCHMARK SUMMARY")
    print("=" * 70)
    print(f"{'GPU Layers':<12} | {'used vram ':<14} | {'Tokens / Sec (t/s)':<18} | {'Total Time (s)':<15}")
    print("-" * 50)
    for r in results:
        if "error" in r:
            print(f"{r['gpu_layers']:<12} | {'FAILED':<18} | {r['error']}")
        else:
            print(f"{r['gpu_layers']:<12} | {r["used_vram"]:<14} |{r['tokens_per_sec']:<18} | {r['total_time_sec']:<15}")
    print("=" * 70)